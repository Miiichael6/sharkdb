{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SharkDB",
  "version": "../package.json",
  "identifier": "com.sharkdb.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SharkDB",
        "width": 760,
        "height": 500,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzMUVDQ0RDMTI2MDMxNjAKUldSZ01XQVMzTXdlMDBEQ2tsZTNhSDdnUjBZSXBSYXRvUU9Mb3hhWnlad2NvU0lwNXIyQUo2N1QK",
      "endpoints": ["https://github.com/Miiichael6/sharkdb/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
